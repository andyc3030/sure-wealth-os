<%# locals: (summary:, **args) %>
<% money_for = ->(amount) { format_money(Money.from_amount(amount.to_d, summary.reporting_currency)) } %>
<% provenance_path = ->(metric) { wealth_os_snapshot_provenance_path(snapshot_id: summary.snapshot_id, metric: metric) } %>

<div id="wealth-os-summary" class="space-y-5 px-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm text-secondary">Immutable daily close</p>
      <p class="text-sm font-medium text-primary"><%= summary.close_date.to_fs(:long) %> · <%= summary.reporting_currency %></p>
    </div>
    <div class="flex items-center gap-3 text-sm">
      <span class="<%= summary.quality_status == "pass" ? "text-success" : "text-warning" %> font-medium">
        <%= summary.quality_status.upcase %>
      </span>
      <%= link_to provenance_path.call("confidence"), class: "text-secondary hover:text-primary underline underline-offset-2" do %>
        Confidence <span class="privacy-sensitive"><%= number_to_percentage(summary.confidence * 100, precision: 0) %></span>
      <% end %>
    </div>
  </div>

  <% headline_metrics = [
       [ "Gross assets", summary.gross_assets, "gross_assets" ],
       [ "Liabilities", summary.total_liabilities, "total_liabilities" ],
       [ "Net worth", summary.net_worth, "net_worth" ],
       [ "Liquid net worth", summary.liquid_net_worth, "liquid_net_worth" ],
       [ "Investable net worth", summary.investable_net_worth, "investable_net_worth" ]
     ] %>
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
    <% headline_metrics.each do |label, value, metric| %>
      <%= link_to provenance_path.call(metric), class: "block rounded-xl bg-container-inset p-3 hover:bg-container-inset-hover transition-colors" do %>
        <p class="text-xs text-secondary"><%= label %></p>
        <p class="mt-1 text-lg font-medium text-primary privacy-sensitive"><%= money_for.call(value) %></p>
        <p class="mt-1 text-[11px] text-secondary">View provenance</p>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
    <div class="rounded-xl bg-container-inset p-4 space-y-3">
      <div>
        <h3 class="text-sm font-medium text-primary">Income states</h3>
        <p class="text-xs text-secondary">Current canonical state at the close.</p>
      </div>
      <% %w[forecast accrued declared received].each do |state| %>
        <div class="flex items-center justify-between gap-3">
          <span class="text-sm text-secondary"><%= state.humanize %></span>
          <%= link_to money_for.call(summary.income_by_state.fetch(state)),
              provenance_path.call("income_#{state}"),
              class: "text-sm font-medium text-primary privacy-sensitive hover:underline" %>
        </div>
      <% end %>
    </div>

    <div class="rounded-xl bg-container-inset p-4 space-y-3">
      <div>
        <h3 class="text-sm font-medium text-primary">Forecast income equivalents</h3>
        <p class="text-xs text-secondary">Derived only from the 365-day contractual income forecast.</p>
      </div>
      <% { "Annual" => "annual", "Monthly" => "monthly", "Daily" => "daily" }.each do |label, period| %>
        <div class="flex items-center justify-between gap-3">
          <span class="text-sm text-secondary"><%= label %></span>
          <%= link_to money_for.call(summary.income_equivalents.fetch(period)),
              provenance_path.call("income_equivalent_#{period}"),
              class: "text-sm font-medium text-primary privacy-sensitive hover:underline" %>
        </div>
      <% end %>
    </div>

    <div class="rounded-xl bg-container-inset p-4 space-y-3">
      <div>
        <h3 class="text-sm font-medium text-primary">Data completeness</h3>
        <p class="text-xs text-secondary">Exact-balance close gate plus visible exceptions.</p>
      </div>
      <div class="grid grid-cols-2 gap-2 text-sm">
        <div><p class="text-secondary">Accounts</p><p class="font-medium"><%= summary.data_completeness.fetch("valuation_account_count") %></p></div>
        <div><p class="text-secondary">Balance coverage</p><p class="font-medium">100%</p></div>
        <div><p class="text-secondary">Open conflicts</p><p class="font-medium"><%= summary.data_completeness.fetch("open_source_conflicts") %></p></div>
        <div><p class="text-secondary">Stale FX</p><p class="font-medium"><%= summary.data_completeness.fetch("stale_fx_rates") %></p></div>
      </div>
    </div>
  </div>

  <div class="rounded-xl bg-container-inset p-1 overflow-x-auto">
    <div class="px-3 py-2"><h3 class="text-sm font-medium text-primary">Contractual cash forecast</h3></div>
    <table class="w-full min-w-[560px] text-sm">
      <thead class="text-xs uppercase text-secondary">
        <tr>
          <th class="px-3 py-2 text-left font-medium">Horizon</th>
          <th class="px-3 py-2 text-right font-medium">Income</th>
          <th class="px-3 py-2 text-right font-medium">Liability payments</th>
          <th class="px-3 py-2 text-right font-medium">Net cash</th>
        </tr>
      </thead>
      <tbody class="bg-container rounded-lg">
        <% [ 7, 30, 90, 365 ].each do |days| %>
          <% row = summary.cash_forecasts.fetch(days) %>
          <tr class="table-divider">
            <td class="px-3 py-3"><%= days %> days</td>
            <td class="px-3 py-3 text-right">
              <%= link_to money_for.call(row.fetch("income")), provenance_path.call("forecast_#{days}_income"),
                  class: "privacy-sensitive hover:underline" %>
            </td>
            <td class="px-3 py-3 text-right">
              <%= link_to money_for.call(row.fetch("liability_payments")), provenance_path.call("forecast_#{days}_liabilities"),
                  class: "privacy-sensitive hover:underline" %>
            </td>
            <td class="px-3 py-3 text-right">
              <%= link_to money_for.call(row.fetch("net_cash")), provenance_path.call("forecast_#{days}_net"),
                  class: "font-medium privacy-sensitive hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex flex-wrap items-start justify-between gap-4 text-xs text-secondary">
    <div>
      <p>Liquid policy: Depository assets − all liabilities.</p>
      <p>Investable policy: Depository + Investment + Crypto assets − all liabilities.</p>
    </div>
    <% if summary.action_now.any? %>
      <div class="text-right">
        <p class="font-medium text-primary">ACTION NOW</p>
        <p><%= summary.action_now.map { |row| row["action"] }.join(" · ") %></p>
      </div>
    <% end %>
  </div>
</div>
