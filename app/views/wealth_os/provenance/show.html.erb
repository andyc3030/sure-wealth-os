<% content_for :page_header do %>
  <div class="space-y-1 mb-6">
    <h1 class="text-xl lg:text-3xl font-medium text-primary">Authoritative metric provenance</h1>
    <p class="text-sm lg:text-base text-secondary">
      <%= @provenance.fetch("metric").humanize %> · close <%= @snapshot.close_date.to_fs(:long) %>
    </p>
  </div>
<% end %>

<div class="max-w-5xl space-y-4 pb-10">
  <%= render DS::Card.new do %>
    <div class="space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <p class="text-xs uppercase text-secondary">Authoritative value</p>
          <p class="text-xl font-medium text-primary privacy-sensitive">
            <%= @provenance.fetch("value") %>
            <%= @provenance.fetch("reporting_currency") unless @provenance.fetch("metric") == "confidence" %>
          </p>
        </div>
        <div>
          <p class="text-xs uppercase text-secondary">Lineage</p>
          <p class="text-sm font-medium text-primary"><%= @provenance.fetch("lineage_status").humanize %></p>
        </div>
        <div>
          <p class="text-xs uppercase text-secondary">Snapshot digest</p>
          <p class="text-xs font-mono text-primary break-all"><%= @provenance.fetch("snapshot_digest") %></p>
        </div>
      </div>

      <div>
        <p class="text-xs uppercase text-secondary">Deterministic calculation</p>
        <p class="text-sm text-primary"><%= @provenance.fetch("calculation") %></p>
      </div>
    </div>
  <% end %>

  <%= render DS::Card.new do %>
    <div class="space-y-3">
      <h2 class="text-base font-medium text-primary">Captured components</h2>
      <p class="text-sm text-secondary">
        These are close-time identifiers and component facts. Raw provider secrets and credentials are never included.
      </p>
      <pre class="privacy-sensitive overflow-x-auto rounded-lg bg-container-inset p-4 text-xs leading-5"><%= JSON.pretty_generate(@provenance.fetch("components")) %></pre>
    </div>
  <% end %>

  <%= render DS::Link.new(variant: "outline", icon: "arrow-left", text: "Back to dashboard", href: root_path) %>
</div>
